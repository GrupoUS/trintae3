{
  "line_ending": "enforce_lf",
  "load_direnv": "shell_hook",
  "format_on_save": "on",
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": ".oxlintrc.json",
          "fixKind": "safe_fix_or_suggestion",
          "run": "onType",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "biome": {
      "settings": {
        "config_path": "biome.json",
        "require_config_file": true
      }
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "shortest"
          },
          "tsserver": {
            "experimental": {
              "enableProjectDiagnostics": false
            },
            "maxTsServerMemory": 8192,
            "watchOptions": {
              "fallbackPolling": "dynamicPriorityPolling",
              "watchDirectory": "useFsEvents",
              "watchFile": "useFsEventsOnParentDirectory"
            }
          }
        },
        "javascript": {
          "preferences": {
            "importModuleSpecifier": "shortest"
          },
          "tsserver": {
            "maxTsServerMemory": 8192,
            "watchOptions": {
              "fallbackPolling": "dynamicPriorityPolling",
              "watchDirectory": "useFsEvents",
              "watchFile": "useFsEventsOnParentDirectory"
            }
          }
        }
      }
    },
    "typescript-language-server": {
      "settings": {
        "javascript": {
          "preferences": {
            "importModuleSpecifier": "shortest"
          }
        },
        "maxTsServerMemory": 8192,
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "shortest"
          },
          "tsserver": {
            "experimental": {
              "enableProjectDiagnostics": false
            },
            "watchOptions": {
              "fallbackPolling": "dynamicPriorityPolling",
              "watchDirectory": "useFsEvents",
              "watchFile": "useFsEventsOnParentDirectory"
            }
          }
        }
      }
    },
    "astro-language-server": {
      "initialization_options": {
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "shortest"
          }
        }
      }
    }
  },
  "languages": {
    "Astro": {
      "language_servers": ["astro-language-server", "biome", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JavaScript": {
      "language_servers": ["biome", "oxlint", "vtsls", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.fixAll.oxc": true,
        "source.organizeImports.biome": true
      }
    },
    "TypeScript": {
      "language_servers": ["biome", "oxlint", "vtsls", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.fixAll.oxc": true,
        "source.organizeImports.biome": true
      }
    },
    "TSX": {
      "language_servers": ["biome", "oxlint", "vtsls", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.fixAll.oxc": true,
        "source.organizeImports.biome": true
      }
    },
    "JSON": {
      "language_servers": ["biome", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true
      }
    },
    "JSONC": {
      "language_servers": ["biome", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true
      }
    },
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "..."
      ]
    }
  }
}
