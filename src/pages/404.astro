---
import Button from "../components/shared/Button.astro";
import Layout from "../layouts/Layout.astro";
import { whatsappUrlWithText } from "../lib/whatsapp";

const whatsappUrl = whatsappUrlWithText(
	"Olá, Laura! Caí em uma página que não existe no TRINTAE3 — pode me ajudar?",
);
---

<Layout
	title="Página não encontrada (404) — TRINTAE3"
	description="Link incorreto ou página movida. Volte à home do TRINTAE3 ou fale com a Laura no WhatsApp."
	ogImage="/og/trintae3.png"
>
	<section class="min-h-[70vh] flex items-center justify-center px-4 py-32">
		<div class="max-w-lg mx-auto text-center" data-reveal="up">
			<p class="font-serif text-[8rem] md:text-[10rem] leading-none font-bold text-gold mb-4 select-none">
				404
			</p>
			<h1 class="font-serif text-2xl md:text-3xl font-bold text-text-primary mb-4">
				Página não encontrada
			</h1>
			<p class="text-text-muted text-lg mb-10 max-w-md mx-auto">
				O endereço pode ter mudado. Volte para a home do TRINTAE3 ou fale com a Laura.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<Button href="/" variant="primary">Voltar para o início</Button>
				<Button href={whatsappUrl} variant="outline" target="_blank" ariaLabel="Falar com Laura no WhatsApp">
					Falar com Laura
				</Button>
			</div>
		</div>
	</section>
</Layout>
