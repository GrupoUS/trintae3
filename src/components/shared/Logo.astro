---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["inline-flex items-center", className]}>
	<img
		src="/images/brand/trintae3-wordmark.webp"
		alt="TRINTAE3 — Mentoria e Pós-Graduação"
		width="720"
		height="65"
		class="h-6 w-auto sm:h-8 lg:h-9"
		loading="eager"
		decoding="async"
		fetchpriority="high"
	/>
</span>
