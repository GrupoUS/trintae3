---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["inline-flex items-center", className]}>
	<img
		src="/images/products/trintae3.svg"
		alt="TRINTAE3"
		width="220"
		height="48"
		class="h-9 w-auto sm:h-10"
		loading="eager"
		decoding="async"
		fetchpriority="high"
	/>
</span>
