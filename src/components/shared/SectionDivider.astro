---
import BrandSymbol from "./BrandSymbol.astro";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div
	class:list={[
		"mx-auto flex max-w-3xl items-center gap-5 px-4 sm:px-6 lg:px-8",
		className,
	]}
	aria-hidden="true"
>
	<span class="h-px flex-1 bg-gradient-to-r from-transparent to-gold/30"></span>
	<BrandSymbol class="h-7 w-7 shrink-0 text-gold/70" />
	<span class="h-px flex-1 bg-gradient-to-l from-transparent to-gold/30"></span>
</div>
