---
import { whatsappUrlWithText } from "../../lib/whatsapp";
import BrandSeal from "../shared/BrandSeal.astro";
import Button from "../shared/Button.astro";

interface Props {
	guarantee: {
		title: string;
		body: string;
		daysCount: number;
	};
	whatsappMessage?: string;
	helpLabel?: string;
}

const { guarantee, whatsappMessage, helpLabel } = Astro.props;

const helpUrl = whatsappMessage
	? whatsappUrlWithText(whatsappMessage)
	: undefined;
---

<section class="px-4 py-20 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-5xl">
		<div
			class="glass-card relative overflow-hidden rounded-3xl p-8 md:p-12 lg:p-14"
			data-reveal="scale"
		>
			<div class="grid grid-cols-1 items-center gap-8 md:grid-cols-12">
				<!-- Selo da marca (gira lento) com contagem de dias no centro -->
				<div class="md:col-span-4">
					<div class="relative mx-auto h-40 w-40 md:h-48 md:w-48">
						<BrandSeal
							seal="saude-estetica"
							spin
							size={192}
							class="h-full w-full"
						/>
						<div class="absolute inset-0 flex flex-col items-center justify-center">
							<span class="font-serif text-4xl font-bold leading-none text-gold md:text-5xl">
								{guarantee.daysCount}
							</span>
							<span class="mt-1 text-[11px] font-medium uppercase tracking-[0.16em] text-gold-brand">
								dias
							</span>
						</div>
					</div>
				</div>

				<!-- Texto -->
				<div class="md:col-span-8">
					<h2 class="font-serif text-2xl font-bold text-gold md:text-3xl">
						{guarantee.title}
					</h2>
					<p class="mt-4 text-base leading-relaxed text-text-muted md:text-lg">
						{guarantee.body}
					</p>
					{helpUrl && (
						<div class="mt-6">
							<Button
								variant="ghost"
								href={helpUrl}
								size="md"
								target="_blank"
								ariaLabel="Falar com a Laura no WhatsApp sobre a garantia"
							>
								{helpLabel ?? "Tem dúvidas? Fale com a Laura"}
							</Button>
						</div>
					)}
				</div>
			</div>
		</div>
	</div>
</section>
