---
interface Props {
	story: {
		headline: string;
		paragraphs: string[];
		highlight: string;
	};
	image?: string;
}

const { story, image = "/images/photos/IMG_5875.webp" } = Astro.props;
---

<section class="relative overflow-hidden bg-navy px-4 py-20 sm:px-6 lg:px-8">
	<!-- Padronagem da marca (blend lighten: só os traços aparecem sobre o navy) -->
	<img
		src="/images/brand/pattern-navy.webp"
		alt=""
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-70 mix-blend-lighten"
		loading="lazy"
		decoding="async"
	/>

	<div class="relative z-10 mx-auto max-w-7xl">
		<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
			<!-- Image -->
			<div class="relative" data-reveal="left">
				<div class="photo-frame">
					<img
						src={image}
						alt="Dra. Sacha Gualberto, mentora e fundadora do TRINTAE3"
						width="1000"
						height="1250"
						class="h-auto w-full object-cover"
						loading="lazy"
						decoding="async"
						fetchpriority="low"
					/>
				</div>
				<!-- Decorative gold accent -->
				<div class="absolute -right-4 -bottom-4 -z-10 h-full w-full rounded-2xl border-2 border-gold/30" aria-hidden="true"></div>
			</div>

			<!-- Text content -->
			<div data-reveal="right">
				<h2 class="font-serif text-3xl font-bold leading-tight text-text-primary md:text-4xl">
					{story.headline}
				</h2>

				<div class="mt-8 space-y-5">
					{story.paragraphs.map((p) => (
						<p class="text-lg leading-relaxed text-text-muted">
							{p}
						</p>
					))}
				</div>

				<blockquote class="mt-8 border-l-4 border-gold pl-6">
					<p class="font-serif text-lg leading-relaxed font-medium text-text-primary italic">
						{story.highlight}
					</p>
				</blockquote>
			</div>
		</div>
	</div>
</section>
