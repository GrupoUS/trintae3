---
interface Props {
	badges: Array<{ label: string; icon?: string }>;
}

const { badges } = Astro.props;

// Inline Lucide paths for the icon names used by the product badges.
const icons: Record<string, string> = {
	GraduationCap:
		'<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>',
	Sparkles:
		'<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
	BookOpen:
		'<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
	ShieldCheck:
		'<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
};
const fallback = '<path d="M20 6 9 17l-5-5"/>';
---

<section class="border-y border-gold/10 bg-navy" aria-label="Selos e provas do programa">
	<ul
		class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-4 px-4 py-6 sm:px-6 lg:flex lg:items-center lg:justify-between lg:gap-8 lg:px-8"
		role="list"
	>
		{badges.map((badge, i) => (
			<li
				class="flex items-center gap-3"
				data-reveal="up"
				data-reveal-delay={String(Math.min(i + 1, 6))}
			>
				<svg
					class="h-5 w-5 shrink-0 text-gold-brand"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					set:html={icons[badge.icon ?? ""] ?? fallback}
				/>
				<span class="text-sm font-medium leading-snug text-text-muted">
					{badge.label}
				</span>
			</li>
		))}
	</ul>
</section>
