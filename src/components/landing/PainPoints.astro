---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
	audience: string;
	painPoints: Array<{
		icon: string;
		title: string;
		description: string;
	}>;
}

const { audience, painPoints } = Astro.props;
---

<section class="relative overflow-hidden px-4 py-20 sm:px-6 lg:px-8">
	<!-- Textura starfield (atmosfera, fade nas bordas) -->
	<img
		src="/images/brand/texture-starfield.webp"
		alt=""
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-25 mix-blend-screen [mask-image:linear-gradient(to_bottom,transparent,black_25%,black_75%,transparent)]"
		loading="lazy"
		decoding="async"
	/>
	<div class="relative z-10 mx-auto max-w-7xl">
		<SectionHeading
			title="Para quem é este programa?"
			subtitle={audience}
		/>

		<div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
			{painPoints.map((point, index) => (
				<div
					class="group glass-card rounded-2xl p-6 md:p-8 hover:border-gold/30 hover:shadow-lg hover:shadow-gold/5 transition duration-300"
					data-reveal="up"
					data-reveal-delay={String(index + 1)}
				>
					<!-- Icon circle -->
					<div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-linear-to-br from-gold/20 to-gold/5 group-hover:scale-110 transition-transform duration-300">
						<svg
							class="h-6 w-6 text-gold"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="12" cy="12" r="10" />
							<path d="M12 8v4" />
							<path d="M12 16h.01" />
						</svg>
					</div>

					<h3 class="text-lg font-semibold text-text-primary">
						{point.title}
					</h3>
					<p class="mt-3 leading-relaxed text-text-muted">
						{point.description}
					</p>
				</div>
			))}
		</div>
	</div>
</section>
