---
import { whatsappUrlWithText } from "../../lib/whatsapp";
import Logo from "../shared/Logo.astro";

interface Props {
	activeNav?: string;
	ctaLabel?: string;
	ctaMessage?: string;
}

const {
	activeNav,
	ctaLabel = "Quero ser TRINTAE3",
	ctaMessage = "Olá, Laura! Quero saber mais sobre o TRINTAE3.",
} = Astro.props;

const navLinks = [
	{ label: "Programa", href: "#programa", id: "programa" },
	{ label: "Práticas", href: "#praticas", id: "praticas" },
	{ label: "Garantia", href: "#garantia", id: "garantia" },
	{ label: "FAQ", href: "#faq", id: "faq" },
];

const ctaHref = whatsappUrlWithText(ctaMessage);
---

<header
	class="fixed top-0 right-0 left-0 z-50 border-b border-gold/10 bg-navy/90 backdrop-blur-md transition-colors duration-300"
	id="site-header"
>
	<div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
		<a
			href="/"
			class="group flex items-center gap-2 transition-opacity duration-200 hover:opacity-90"
			aria-label="TRINTAE3 — Página inicial"
		>
			<Logo />
		</a>

		<nav class="hidden items-center gap-1 lg:flex" aria-label="Navegação principal">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class:list={[
						"relative px-4 py-2 text-sm font-medium tracking-wide transition-colors duration-200",
						activeNav === link.id
							? "text-gold after:absolute after:bottom-0 after:left-4 after:right-4 after:h-0.5 after:bg-gold after:content-['']"
							: "text-text-muted hover:text-text-primary",
					]}
					aria-current={activeNav === link.id ? "page" : undefined}
				>
					{link.label}
				</a>
			))}

			<a
				href={ctaHref}
				target="_blank"
				rel="noopener noreferrer"
				class="ml-4 rounded-sm bg-gold px-5 py-2 text-sm font-semibold text-navy transition duration-200 hover:bg-gold-light hover:shadow-lg hover:shadow-gold/20"
			>
				{ctaLabel}
			</a>
		</nav>

		<button
			type="button"
			class="flex h-10 w-10 items-center justify-center rounded-sm text-text-muted transition-colors duration-200 hover:text-gold lg:hidden"
			aria-label="Abrir menu de navegação"
			aria-expanded="false"
			aria-controls="mobile-menu"
			id="hamburger-btn"
		>
			<svg
				class="hamburger-icon h-6 w-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<line x1="4" x2="20" y1="6" y2="6" />
				<line x1="4" x2="20" y1="12" y2="12" />
				<line x1="4" x2="20" y1="18" y2="18" />
			</svg>
			<svg
				class="close-icon hidden h-6 w-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M18 6 6 18" />
				<path d="m6 6 12 12" />
			</svg>
		</button>
	</div>

	<div
		class="fixed inset-0 top-0 z-40 flex -translate-y-full flex-col bg-navy/98 opacity-0 backdrop-blur-lg transition-[transform,opacity,visibility] duration-300 ease-out invisible pointer-events-none lg:hidden"
		id="mobile-menu"
		aria-label="Menu de navegação mobile"
		role="dialog"
		aria-modal="true"
	>
		<div class="flex items-center justify-between border-b border-gold/10 px-4 py-3 sm:px-6">
			<a href="/" class="inline-flex" aria-label="TRINTAE3 — Página inicial">
				<Logo />
			</a>
			<button
				type="button"
				class="flex h-10 w-10 items-center justify-center rounded-sm text-text-muted transition-colors duration-200 hover:text-gold"
				aria-label="Fechar menu de navegação"
				id="mobile-close-btn"
			>
				<svg
					class="h-6 w-6"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M18 6 6 18" />
					<path d="m6 6 12 12" />
				</svg>
			</button>
		</div>

		<nav class="flex flex-1 flex-col gap-1 overflow-y-auto px-4 py-6 sm:px-6" aria-label="Navegação mobile">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class:list={[
						"rounded-sm px-4 py-3 text-lg font-medium tracking-wide transition-colors duration-200",
						activeNav === link.id
							? "bg-navy-light text-gold"
							: "text-text-muted hover:bg-navy-light/50 hover:text-text-primary",
					]}
					aria-current={activeNav === link.id ? "page" : undefined}
				>
					{link.label}
				</a>
			))}

			<a
				href={ctaHref}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-6 rounded-sm bg-gold px-5 py-3 text-center text-base font-semibold text-navy transition duration-200 hover:bg-gold-light"
			>
				{ctaLabel}
			</a>
		</nav>
	</div>
</header>

<div class="h-[60px]" aria-hidden="true"></div>

<script>
	function initHeader() {
		const hamburgerBtn = document.getElementById("hamburger-btn");
		const mobileCloseBtn = document.getElementById("mobile-close-btn");
		const mobileMenu = document.getElementById("mobile-menu");
		const hamburgerIcon = hamburgerBtn?.querySelector(".hamburger-icon");
		const closeIcon = hamburgerBtn?.querySelector(".close-icon");

		function openMenu() {
			if (!mobileMenu || !hamburgerBtn || !hamburgerIcon || !closeIcon) return;
			mobileMenu.classList.remove("-translate-y-full", "opacity-0", "invisible", "pointer-events-none");
			mobileMenu.classList.add("translate-y-0", "opacity-100", "visible", "pointer-events-auto");
			hamburgerBtn.setAttribute("aria-expanded", "true");
			hamburgerIcon.classList.add("hidden");
			closeIcon.classList.remove("hidden");
			document.body.style.overflow = "hidden";
			mobileCloseBtn?.focus();
		}

		function closeMenu() {
			if (!mobileMenu || !hamburgerBtn || !hamburgerIcon || !closeIcon) return;
			mobileMenu.classList.add("-translate-y-full", "opacity-0", "pointer-events-none");
			mobileMenu.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
			hamburgerBtn.setAttribute("aria-expanded", "false");
			hamburgerIcon.classList.remove("hidden");
			closeIcon.classList.add("hidden");
			document.body.style.overflow = "";
			setTimeout(() => {
				if (mobileMenu.classList.contains("-translate-y-full")) {
					mobileMenu.classList.add("invisible");
					mobileMenu.classList.remove("visible");
				}
			}, 300);
			hamburgerBtn.focus();
		}

		hamburgerBtn?.addEventListener("click", openMenu);
		mobileCloseBtn?.addEventListener("click", closeMenu);

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !mobileMenu?.classList.contains("-translate-y-full")) {
				closeMenu();
			}
		});

		const header = document.getElementById("site-header");
		let ticking = false;

		function onScroll() {
			if (!ticking) {
				requestAnimationFrame(() => {
					if (!header) return;
					if (window.scrollY > 20) {
						header.classList.add("border-gold/20");
						header.classList.remove("border-gold/10");
					} else {
						header.classList.remove("border-gold/20");
						header.classList.add("border-gold/10");
					}
					ticking = false;
				});
				ticking = true;
			}
		}

		window.addEventListener("scroll", onScroll, { passive: true });

		// Close mobile menu on internal anchor click
		document.querySelectorAll('#mobile-menu a[href^="#"]').forEach((link) => {
			link.addEventListener("click", () => closeMenu());
		});
	}

	initHeader();
</script>
